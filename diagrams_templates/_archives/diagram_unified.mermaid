stateDiagram-v2
    direction TB

    %% Initial Entry
    [*] --> PHASE_ANALYSIS

    state "Phase 1: Analyse & Qualification" as PHASE_ANALYSIS {
        direction TB
        OPEN --> SUBMITTED
        SUBMITTED --> MACRO_STUDY
        MACRO_STUDY --> BUSINESS_ANALYST
        BUSINESS_ANALYST --> INFORMATION_NEEDED
        INFORMATION_NEEDED --> OPEN
        WAITING_FOR_EXT_STAKEHOLDERS
        
        state "MACRO-STUDY" as MACRO_STUDY
        state "BUSINESS ANALYST" as BUSINESS_ANALYST
        state "INFORMATION NEEDED" as INFORMATION_NEEDED
        state "WAITING FOR EXT STAKEHOLDERS" as WAITING_FOR_EXT_STAKEHOLDERS
    }

    PHASE_ANALYSIS --> PHASE_VALIDATION : Accepté
    PHASE_ANALYSIS --> PHASE_TERMINAL : Rejeté / Abandonné

    state "Phase 2: Validation & Priorisation" as PHASE_VALIDATION {
        direction TB
        ACCEPTED --> CANDIDACY_GATE
        ACCEPTED --> A_PRIORISER
        A_PRIORISER --> READY
        A_PRIORISER --> ADDED_IN_BACKLOG

        state "ACCEPTED" as ACCEPTED
        state "CANDIDACY GATE" as CANDIDACY_GATE
        state "À PRIORISER" as A_PRIORISER
        state "READY" as READY
        state "ADDED IN BACKLOG" as ADDED_IN_BACKLOG
    }

    PHASE_VALIDATION --> PHASE_EXECUTION : Start Work

    state "Phase 3: Exécution & Développement" as PHASE_EXECUTION {
        direction TB
        IN_PROGRESS --> WAITING_FOR_REPRODUCTION
        WAITING_FOR_REPRODUCTION --> IN_PROGRESS
        IN_PROGRESS --> SUSPENDED
        SUSPENDED --> IN_PROGRESS
        IMPLEMENTATION_IN_PROGRESS

        state "IN PROGRESS" as IN_PROGRESS
        state "WAITING FOR REPRODUCTION" as WAITING_FOR_REPRODUCTION
        state "SUSPENDED" as SUSPENDED
        state "IMPLEMENTATION IN PROGRESS" as IMPLEMENTATION_IN_PROGRESS
    }

    PHASE_EXECUTION --> PHASE_DELIVERY : Livrer

    state "Phase 4: Livraison & Qualité" as PHASE_DELIVERY {
        direction TB
        TO_DELIVER --> TEST_PRODUIT
        TEST_PRODUIT --> TO_BE_VALIDATED_BY_CODA
        TO_BE_VALIDATED_BY_CODA --> TESTING_BLOCKED
        TESTING_BLOCKED --> TO_BE_VALIDATED_BY_CODA
        
        TO_DELIVER --> MERGE_REQUESTED
        MERGE_REQUESTED --> READY_FOR_RELEASE
        
        TO_BE_VALIDATED_BY_OWNER
        WAITING_FOR_CONFIRMATION
        SOLVED
        RESOLVED

        state "TO DELIVER" as TO_DELIVER
        state "TEST PRODUIT" as TEST_PRODUIT
        state "TO BE VALIDATED BY CODA" as TO_BE_VALIDATED_BY_CODA
        state "TESTING BLOCKED" as TESTING_BLOCKED
        state "MERGE REQUESTED" as MERGE_REQUESTED
        state "READY FOR RELEASE" as READY_FOR_RELEASE
        state "TO BE VALIDATED BY OWNER" as TO_BE_VALIDATED_BY_OWNER
        state "WAITING FOR CONFIRMATION" as WAITING_FOR_CONFIRMATION
    }

    PHASE_DELIVERY --> PHASE_TERMINAL : Fermer

    state "Phase 5: Clôture" as PHASE_TERMINAL {
        direction LR
        REJECTED --> CLOSED
        CLOSED --> CLOSED_REJETED
        ABANDONED

        state "REJECTED" as REJECTED
        state "CLOSED" as CLOSED
        state "CLOSED/REJETED" as CLOSED_REJETED
        state "ABANDONED" as ABANDONED
    }

    PHASE_TERMINAL --> [*]
