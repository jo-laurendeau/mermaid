stateDiagram-v2
    direction TB

    %% Global Entry
    [*] --> OPEN

    %% Main Path
    OPEN --> ACCEPTED
    ACCEPTED --> IN_PROGRESS
    IN_PROGRESS --> TO_DELIVER
    TO_DELIVER --> TEST_PRODUIT
    TEST_PRODUIT --> TO_BE_VALIDATED_BY_CODA
    
    TO_DELIVER --> MERGE_REQUESTED
    MERGE_REQUESTED --> READY_FOR_RELEASE

    %% Feedback & Loops
    OPEN --> INFORMATION_NEEDED
    INFORMATION_NEEDED --> OPEN

    ACCEPTED --> SUSPENDED
    SUSPENDED --> ACCEPTED

    ACCEPTED --> WAITING_FOR_EXT_STAKEHOLDERS
    WAITING_FOR_EXT_STAKEHOLDERS --> ACCEPTED

    IN_PROGRESS --> WAITING_FOR_REPRODUCTION
    WAITING_FOR_REPRODUCTION --> IN_PROGRESS
    WAITING_FOR_REPRODUCTION --> TO_DELIVER

    TO_DELIVER --> IN_PROGRESS
    TO_BE_VALIDATED_BY_CODA --> TO_DELIVER

    TO_BE_VALIDATED_BY_CODA --> TESTING_BLOCKED
    TESTING_BLOCKED --> TO_BE_VALIDATED_BY_CODA

    %% Rejection & Closing
    OPEN --> REJECTED
    REJECTED --> TO_BE_VALIDATED_BY_OWNER
    TO_BE_VALIDATED_BY_OWNER --> CLOSED
    
    READY_FOR_RELEASE --> CLOSED

    %% Terminal States
    OPEN --> ABANDONED
    OPEN --> CLOSED_REJETED

    %% State Definitions
    state "OPEN" as OPEN
    state "ACCEPTED" as ACCEPTED
    state "SUSPENDED" as SUSPENDED
    state "WAITING FOR EXT STAKEHOLDERS" as WAITING_FOR_EXT_STAKEHOLDERS
    state "IN PROGRESS" as IN_PROGRESS
    state "WAITING FOR REPRODUCTION" as WAITING_FOR_REPRODUCTION
    state "TO DELIVER" as TO_DELIVER
    state "TEST PRODUIT" as TEST_PRODUIT
    state "MERGE REQUESTED" as MERGE_REQUESTED
    state "READY FOR RELEASE" as READY_FOR_RELEASE
    state "TO BE VALIDATED BY CODA" as TO_BE_VALIDATED_BY_CODA
    state "TESTING BLOCKED" as TESTING_BLOCKED
    state "INFORMATION NEEDED" as INFORMATION_NEEDED
    state "REJECTED" as REJECTED
    state "TO BE VALIDATED BY OWNER" as TO_BE_VALIDATED_BY_OWNER
    state "ABANDONED" as ABANDONED
    state "CLOSED" as CLOSED
    state "CLOSED/REJETED" as CLOSED_REJETED

    %% Annotation
    note left of OPEN
        Transitions "Toutes":
        Permettent de commenter
        ou d'abandonner à tout moment.
    end note
